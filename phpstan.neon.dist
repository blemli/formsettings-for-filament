includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 4
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # The trait is consumer-facing package API; nothing inside this package uses it.
        - identifier: trait.unused
          path: src/Concerns/HasFormSettings.php

